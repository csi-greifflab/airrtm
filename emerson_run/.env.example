# Copy to `.env` and adjust. Consumed by settings.py and the shell scripts.

# Root of the run; PROCESSED_DATA_DIR and MODEL_DIR usually live under it.
PROJECT_DIR=/Warehouse/Andrei/emerson/

# AIRR-format TSVs plus metadata.csv (columns: label, filename, split).
RAW_DATA_DIR=/Warehouse/Andrei/emerson/raw_data

# Written by `1_preprocess_repertoires.py`. Use a NEW directory when re-running
# preprocessing with clonal counts and V/J genes, so the existing datasets under
# processed_data/ stay intact for comparison.
PROCESSED_DATA_DIR=/Warehouse/Andrei/emerson/processed_data_vj

MODEL_DIR=/Warehouse/Andrei/emerson/model/

# Every repertoire is padded AND truncated to exactly MAX_SEQUENCE_LENGTH, so all
# repertoires can be concatenated into one batch. The existing Emerson datasets use
# 26; observed CDR3 lengths run 4..24.
MAX_SEQUENCE_LENGTH=26
MIN_SEQUENCE_LENGTH=4

# Repertoires with fewer sequences than this are dropped from metadata.csv.
# The smallest Emerson repertoire has ~35k sequences.
MIN_N_SEQUENCES=10000

CONFIG_PATH=/home/as/git/airrtm/emerson_run/config.yaml
